{
  "name": "linux_agent_health",
  "title": "Linux Agent Health",
  "description": "Ground-truth operational health and liveness of Linux agents. Purely operational, not threat-oriented.",
  "folder_id": "general",
  "panels": [
    {
      "id": "agent_liveness",
      "title": "Agent Liveness",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 2,
      "refresh_interval": 30,
      "status": "healthy",
      "content": "",
      "renderer": {
        "type": "table",
        "config": {
          "columns": [
            {
              "field": "agent_id",
              "label": "Agent ID",
              "type": "string"
            },
            {
              "field": "status",
              "label": "Status",
              "type": "string"
            },
            {
              "field": "observed_at",
              "label": "Last Observed",
              "type": "datetime"
            }
          ],
          "sortable": true,
          "filterable": true
        }
      },
      "data_source": {
        "endpoint": "/api/dashboards/linux-agent-health",
        "path": "agent_liveness"
      }
    },
    {
      "id": "cpu_health",
      "title": "CPU Health",
      "x": 0,
      "y": 2,
      "w": 4,
      "h": 2,
      "refresh_interval": 30,
      "status": "healthy",
      "content": "",
      "renderer": {
        "type": "stat_grid",
        "config": {
          "stats": [
            {
              "field": "cpu.utilization",
              "label": "CPU Utilization",
              "unit": "%",
              "type": "number"
            },
            {
              "field": "cpu.core_count",
              "label": "Core Count",
              "unit": "cores",
              "type": "number"
            },
            {
              "field": "cpu.agent_process_cpu",
              "label": "Agent Process CPU",
              "unit": "%",
              "type": "number"
            }
          ],
          "aggregate": "avg"
        }
      },
      "data_source": {
        "endpoint": "/api/dashboards/linux-agent-health",
        "path": "cpu_health"
      }
    },
    {
      "id": "memory_health",
      "title": "Memory Health",
      "x": 4,
      "y": 2,
      "w": 4,
      "h": 2,
      "refresh_interval": 30,
      "status": "healthy",
      "content": "",
      "renderer": {
        "type": "stat_grid",
        "config": {
          "stats": [
            {
              "field": "memory.total",
              "label": "Total Memory",
              "unit": "bytes",
              "type": "number",
              "format": "bytes"
            },
            {
              "field": "memory.used",
              "label": "Used Memory",
              "unit": "bytes",
              "type": "number",
              "format": "bytes"
            },
            {
              "field": "memory.free",
              "label": "Free Memory",
              "unit": "bytes",
              "type": "number",
              "format": "bytes"
            },
            {
              "field": "memory.agent_rss",
              "label": "Agent RSS",
              "unit": "bytes",
              "type": "number",
              "format": "bytes"
            }
          ],
          "aggregate": "avg"
        }
      },
      "data_source": {
        "endpoint": "/api/dashboards/linux-agent-health",
        "path": "memory_health"
      }
    },
    {
      "id": "disk_io_health",
      "title": "Disk I/O Health",
      "x": 8,
      "y": 2,
      "w": 4,
      "h": 2,
      "refresh_interval": 30,
      "status": "healthy",
      "content": "",
      "renderer": {
        "type": "timeseries",
        "config": {
          "x_axis": {
            "field": "observed_at",
            "type": "datetime"
          },
          "series": [
            {
              "field": "disk.read_bytes",
              "label": "Read Bytes",
              "type": "number",
              "unit": "bytes",
              "format": "bytes"
            },
            {
              "field": "disk.write_bytes",
              "label": "Write Bytes",
              "type": "number",
              "unit": "bytes",
              "format": "bytes"
            },
            {
              "field": "disk.read_iops",
              "label": "Read IOPS",
              "type": "number",
              "unit": "iops"
            },
            {
              "field": "disk.write_iops",
              "label": "Write IOPS",
              "type": "number",
              "unit": "iops"
            }
          ],
          "group_by": "agent_id"
        }
      },
      "data_source": {
        "endpoint": "/api/dashboards/linux-agent-health",
        "path": "disk_io_health"
      }
    },
    {
      "id": "network_health",
      "title": "Network Health",
      "x": 0,
      "y": 4,
      "w": 6,
      "h": 2,
      "refresh_interval": 30,
      "status": "healthy",
      "content": "",
      "renderer": {
        "type": "timeseries",
        "config": {
          "x_axis": {
            "field": "observed_at",
            "type": "datetime"
          },
          "series": [
            {
              "field": "network.bytes_in",
              "label": "Bytes In",
              "type": "number",
              "unit": "bytes",
              "format": "bytes"
            },
            {
              "field": "network.bytes_out",
              "label": "Bytes Out",
              "type": "number",
              "unit": "bytes",
              "format": "bytes"
            },
            {
              "field": "network.drops",
              "label": "Drops",
              "type": "number",
              "unit": "packets"
            },
            {
              "field": "network.errors",
              "label": "Errors",
              "type": "number",
              "unit": "packets"
            }
          ],
          "group_by": "agent_id"
        }
      },
      "data_source": {
        "endpoint": "/api/dashboards/linux-agent-health",
        "path": "network_health"
      }
    },
    {
      "id": "system_state",
      "title": "System State",
      "x": 6,
      "y": 4,
      "w": 6,
      "h": 2,
      "refresh_interval": 30,
      "status": "healthy",
      "content": "",
      "renderer": {
        "type": "key_value",
        "config": {
          "fields": [
            {
              "field": "system_state.host_uptime",
              "label": "Host Uptime",
              "type": "number",
              "unit": "seconds"
            },
            {
              "field": "system_state.process_count",
              "label": "Process Count",
              "type": "number"
            },
            {
              "field": "system_state.agent_process_status",
              "label": "Agent Process Status",
              "type": "string"
            }
          ],
          "group_by": "agent_id",
          "flatten": true
        }
      },
      "data_source": {
        "endpoint": "/api/dashboards/linux-agent-health",
        "path": "system_state"
      }
    },
    {
      "id": "metrics_collection_status",
      "title": "Metrics Collection Status",
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 2,
      "refresh_interval": 30,
      "status": "healthy",
      "content": "",
      "renderer": {
        "type": "table",
        "config": {
          "columns": [
            {
              "field": "agent_id",
              "label": "Agent ID",
              "type": "string"
            },
            {
              "field": "metrics_status.cpu",
              "label": "CPU",
              "type": "string"
            },
            {
              "field": "metrics_status.disk",
              "label": "Disk",
              "type": "string"
            },
            {
              "field": "metrics_status.network",
              "label": "Network",
              "type": "string"
            }
          ],
          "sortable": true,
          "filterable": true
        }
      },
      "data_source": {
        "endpoint": "/api/dashboards/linux-agent-health",
        "path": "metrics_collection_status"
      }
    }
  ]
}
