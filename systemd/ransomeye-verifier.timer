# Path and File Name : /home/ransomeye/rebuild/systemd/ransomeye-verifier.timer
# Author: nXxBku0CKFAJCBN3X1g3bQk7OxYQylg8CMw1iGsq7gU
# Details of functionality of this file: Systemd timer for RansomEye Continuous Verification (runs every 5 minutes)

[Unit]
Description=RansomEye Continuous Verification Timer - Runs every 5 minutes
Requires=ransomeye-verifier.service

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
AccuracySec=1s

[Install]
WantedBy=timers.target

