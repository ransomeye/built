# Path and File Name : /home/ransomeye/rebuild/systemd/ransomeye-auto-evolution.timer
# Author: nXxBku0CKFAJCBN3X1g3bQk7OxYQylg8CMw1iGsq7bQk7OxYQylg8CMw1iGsq7gU
# Details of functionality of this file: Systemd timer for monthly auto-evolution cycles

[Unit]
Description=RansomEye Auto-Evolution Timer (Monthly)
Documentation=https://ransomeye.tech
Requires=ransomeye-auto-evolution.service

[Timer]
OnCalendar=monthly
# Run on the 1st of every month at 3:00 AM
OnCalendar=*-*-01 03:00
RandomizedDelaySec=7200
Persistent=true

[Install]
WantedBy=timers.target

