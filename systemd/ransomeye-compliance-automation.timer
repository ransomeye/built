# Path and File Name : /home/ransomeye/rebuild/systemd/ransomeye-compliance-automation.timer
# Author: nXxBku0CKFAJCBN3X1g3bQk7OxYQylg8CMw1iGsq7gU
# Details of functionality of this file: Monthly compliance evidence generation timer

[Unit]
Description=RansomEye Compliance Automation Timer - Monthly Evidence Generation
Requires=ransomeye-compliance-automation.service

[Timer]
OnCalendar=monthly
# Run on 1st of each month at 00:00 UTC
Persistent=true
RandomizedDelaySec=0

[Install]
WantedBy=timers.target

