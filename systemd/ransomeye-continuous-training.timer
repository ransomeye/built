# Path and File Name : /home/ransomeye/rebuild/systemd/ransomeye-continuous-training.timer
# Author: nXxBku0CKFAJCBN3X1g3bQk7OxYQylg8CMw1iGsq7bQk7OxYQylg8CMw1iGsq7gU
# Details of functionality of this file: Systemd timer for weekly continuous training

[Unit]
Description=RansomEye Continuous Training Timer (Weekly)
Documentation=https://ransomeye.tech
Requires=ransomeye-continuous-training.service

[Timer]
OnCalendar=weekly
# Run every Monday at 2:00 AM
OnCalendar=Mon 02:00
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target

