# Path and File Name : /home/ransomeye/rebuild/systemd/ransomeye-weekly-pipeline-replay.timer
# Author: nXxBku0CKFAJCBN3X1g3bQk7OxYQylg8CMw1iGsq7gU
# Details of functionality of this file: Weekly Pipeline Sanity Replay Timer

[Unit]
Description=RansomEye Weekly Pipeline Sanity Replay Timer
Requires=ransomeye-weekly-pipeline-replay.service

[Timer]
OnCalendar=Sun 02:00
# Run weekly on Sunday at 02:00 UTC
Persistent=true
RandomizedDelaySec=0

[Install]
WantedBy=timers.target

