# Path and File Name : /home/ransomeye/rebuild/systemd/ransomeye-ui.service
# Author: nXxBku0CKFAJCBN3X1g3bQk7OxYQylg8CMw1iGsq7gU
# Details of functionality of this file: Systemd service unit for RansomEye UI Server (PROMPT-48)

[Unit]
Description=RansomEye UI Server - Production-ready Day-1 dashboards
After=network.target postgresql.service
Requires=network.target postgresql.service
ConditionPathExists=/home/ransomeye/rebuild/ui/server.py

[Service]
Type=simple
User=ransomeye
Group=ransomeye
WorkingDirectory=/home/ransomeye/rebuild
ExecStart=/usr/bin/python3 /home/ransomeye/rebuild/ui/server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables (env-driven, no hardcoded IPs)
Environment="DB_HOST=localhost"
Environment="DB_PORT=5432"
Environment="DB_NAME=ransomeye"
Environment="DB_USER=gagan"
Environment="DB_PASS=gagan"

# UI binding configuration from environment file (network-agnostic)
# Supported variables in /etc/ransomeye/ui.env:
#   RANSOMEYE_UI_BIND_ADDRESS (default: 127.0.0.1) - Bind address (127.0.0.1, 0.0.0.0, or specific IP)
#   RANSOMEYE_UI_BIND_PORT (default: 8081) - Port number
#   RANSOMEYE_UI_ALLOWED_ORIGINS - Comma-separated CORS origins (e.g., "http://192.168.1.50:8081")
#   RANSOMEYE_UI_CORS_CREDENTIALS (default: false) - Enable CORS credentials
#   RANSOMEYE_UI_TRUST_PROXY (default: false) - Trust X-Forwarded-For headers
#   RANSOMEYE_UI_X_FRAME_OPTIONS (default: DENY) - X-Frame-Options header
#   RANSOMEYE_UI_REFERRER_POLICY (default: strict-origin-when-cross-origin) - Referrer-Policy
#   RANSOMEYE_UI_CSP - Content-Security-Policy header (optional)
# See /home/ransomeye/rebuild/ui/NETWORK_HARDENING.md for details
EnvironmentFile=/etc/ransomeye/ui.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ransomeye/rebuild

[Install]
WantedBy=multi-user.target

